# Google Gemini API Key (Required for Question Generation and Evaluation)
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Optional OpenAI API Key (Fallback provider)
OPENAI_API_KEY=
